{
  "name": "embed-block-figma",
  "version": "0.4.0",
  "description": "Adds a Figma embed block to the WordPress Block Editor.",
  "homepage": "https://github.com/10up/embed-block-figma",
  "license": "GPL-2.0-or-later",
  "author": {
    "name": "10up",
    "email": "opensource@10up.com",
    "url": "https://10up.com"
  },
  "scripts": {
    "start": "10up-toolkit start",
    "watch": "10up-toolkit watch --port=3000 --hot",
    "build": "10up-toolkit build",
    "format-js": "10up-toolkit format-js",
    "lint-js": "10up-toolkit lint-js",
    "lint-style": "10up-toolkit lint-style",
    "test": "10up-toolkit test-unit-jest",
    "clean-dist": "rm -rf ./dist",
    "wp-env": "wp-env",
    "wp-env:test": "wp-env --config=.wp-env.test.json",
    "test:php": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/embed-block-figma vendor/bin/phpunit -c phpunit.xml.dist",
    "test:php:multisite": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/embed-block-figma env WP_MULTISITE=1 vendor/bin/phpunit -c phpunit.xml.dist",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:debug": "playwright test --config tests/e2e/playwright.config.ts --ui",
    "archive": "composer archive --file=embed-block-figma --format=zip",
    "postarchive": "rm -rf embed-block-figma && unzip embed-block-figma.zip -d embed-block-figma && rm embed-block-figma.zip && zip -r embed-block-figma.zip embed-block-figma && rm -rf embed-block-figma"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@wordpress/e2e-test-utils-playwright": "3.3.0",
    "@wordpress/env": "12.2.0",
    "10up-toolkit": "^6.5.1",
    "classnames": "^2.3.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "3.2.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "includes/**/*.js": [
      "npm run lint:js"
    ],
    "/includes/**/*.css": [
      "lint:css"
    ],
    "*.php": [
      "./vendor/bin/phpcs . --extensions=php --standard=phpcs.xml --warning-severity=8 -s"
    ]
  },
  "10up-toolkit": {
    "useBlockAssets": false,
    "entry": {
      "figma-embed": "./src/assets/js/figma-embed.js"
    }
  }
}
